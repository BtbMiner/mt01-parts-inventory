<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MT01" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_light</item>
        <item name="colorOnPrimaryContainer">@color/blue_700</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status and Background -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/floral_white</item>

        <!-- Custom Attributes (Light) -->
        <item name="colorPageBackground">@color/neutral_background</item>
        <item name="colorCardBackground">@color/white</item>
        <item name="colorTextPrimary">@color/black</item>
        <item name="colorTextSecondary">@color/grey_text</item>

        <item name="colorStatusLow">@color/orange_600</item>
        <item name="colorStatusOut">@color/red_disabled</item>

        <item name="colorTxnIn">@color/green_700</item>
        <item name="colorTxnOut">@color/orange_600</item>
        <item name="colorTxnReturn">@color/blue_dark</item>

        <!-- Material 3 Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Material3.HeadlineLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Material3.BodyLarge</item>
    </style>

    <style name="Theme.MT01.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MT01.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="Theme.MT01.PopupOverlay" parent="ThemeOverlay.Material3.Light" />
</resources>