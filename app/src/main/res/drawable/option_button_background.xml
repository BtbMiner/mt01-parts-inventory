<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state (when the TextView is "activated") -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/blue_500" /> <!-- Selected color -->
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/blue_700" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" /> <!-- Default color -->
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/material_dynamic_neutral60" />
        </shape>
    </item>
</selector>
