<resources>
    <!-- Base application theme (Night). -->
    <style name="Theme.MT01" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue_200</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/blue_700</item>
        <item name="colorOnPrimaryContainer">@color/blue_200</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status and Background -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/eerie_black</item>

        <!-- Custom Attributes (Night) -->
        <item name="colorPageBackground">@color/black</item>
        <item name="colorCardBackground">@color/jet_black_soft</item>
        <item name="colorTextPrimary">@color/white</item>
        <item name="colorTextSecondary">@color/material_dynamic_neutral60</item>

        <item name="colorStatusLow">@color/orange_400</item>
        <item name="colorStatusOut">@color/red_disabled</item>

        <item name="colorTxnIn">@color/teal_200</item>
        <item name="colorTxnOut">@color/orange_300</item>
        <item name="colorTxnReturn">@color/blue_light</item>

        <!-- Material 3 Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Material3.HeadlineLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Material3.BodyLarge</item>
    </style>
</resources>